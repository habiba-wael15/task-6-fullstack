# ==============================================================================
# Saiket Systems Task 6: Full Stack User Management System - Server Environment
# Copy this file to .env and adjust values for your local environment.
# ==============================================================================

# Server Port
PORT=3000
NODE_ENV=development

# Allowed CORS Origin (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# Database Authentication Mode: 'windows' (default) or 'sql'
DB_AUTH_TYPE=windows

# Database Host & Name (Task 6 dedicated database: SaiketTask6DB)
DB_SERVER=DESKTOP-F3PIBN9
DB_NAME=SaiketTask6DB
DB_PORT=1433

# ------------------------------------------------------------------------------
# WINDOWS AUTHENTICATION CONFIGURATION (used when DB_AUTH_TYPE=windows)
# Uses msnodesqlv8 with your installed Windows ODBC Driver.
# Standard installed driver on Windows 10/11: 'ODBC Driver 17 for SQL Server'
# ------------------------------------------------------------------------------
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# ------------------------------------------------------------------------------
# SQL SERVER AUTHENTICATION CONFIGURATION (used when DB_AUTH_TYPE=sql)
# Standard username / password authentication (e.g., 'sa' or custom SQL login).
# ------------------------------------------------------------------------------
DB_USER=your_sql_username
DB_PASSWORD=your_sql_password
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# ------------------------------------------------------------------------------
# Connection Pool Settings
# ------------------------------------------------------------------------------
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=15000

